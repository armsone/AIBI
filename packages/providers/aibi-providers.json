{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIBI Provider Configurations",
  "version": "1.0.0",
  "updatedAt": "2026-08-28",
  "volatilityNotice": "Web application DOM structures change frequently. Maintain and update these selector chains independently of core orchestrator logic.",
  "providers": {
    "gemini": {
      "id": "gemini",
      "displayName": "Google Gemini",
      "status": "active",
      "initialUrl": "https://gemini.google.com/app",
      "allowedScriptOrigins": [
        "https://gemini.google.com"
      ],
      "allowedAuthOrigins": [
        "https://accounts.google.com",
        "https://myaccount.google.com",
        "https://support.google.com"
      ],
      "selectors": {
        "promptInput": [
          "div.ql-editor[contenteditable='true']",
          "textarea[aria-label*='prompt' i]",
          "rich-textarea p",
          "div[role='textbox']"
        ],
        "submitButton": [
          "button[aria-label*='Send' i]",
          "button[aria-label*='보내기' i]",
          "button.send-button",
          "button[mat-icon-button][aria-label*='send' i]"
        ],
        "stopButton": [
          "button[aria-label*='Stop' i]",
          "button[aria-label*='중지' i]",
          "button.stop-generating-button"
        ],
        "assistantMessage": [
          "message-content",
          "div.model-response-text",
          "div[data-test-id='model-response']",
          ".response-container-content"
        ],
        "preCode": [
          "pre code",
          "code-block pre"
        ],
        "errorBanner": [
          ".error-message",
          "[data-test-id='error-card']",
          ".sparkle-error-container"
        ],
        "loginIndicator": [
          "a[href*='accounts.google.com/ServiceLogin']",
          "a[aria-label*='Sign in' i]",
          "button[aria-label*='로그인' i]"
        ],
        "challengeIndicator": [
          "iframe[src*='recaptcha']",
          "div.g-recaptcha",
          "#challenge-stage"
        ]
      },
      "quirks": {
        "isContentEditable": true,
        "requiresEnterEvent": false,
        "notes": "Gemini uses Quill rich editor (ql-editor). Synthetic input events and text node insertion required."
      }
    },
    "chatgpt": {
      "id": "chatgpt",
      "displayName": "OpenAI ChatGPT",
      "status": "active",
      "initialUrl": "https://chatgpt.com/",
      "allowedScriptOrigins": [
        "https://chatgpt.com",
        "https://chat.openai.com"
      ],
      "allowedAuthOrigins": [
        "https://auth0.openai.com",
        "https://auth.openai.com",
        "https://accounts.google.com",
        "https://appleid.apple.com",
        "https://login.microsoftonline.com"
      ],
      "selectors": {
        "promptInput": [
          "#prompt-textarea",
          "textarea[data-id='root']",
          "div[contenteditable='true']#prompt-textarea",
          "div[role='textbox']"
        ],
        "submitButton": [
          "button[data-testid='send-button']",
          "button[aria-label*='Send' i]",
          "button[aria-label*='보내기' i]",
          "button:has(svg[data-icon='arrow-up'])"
        ],
        "stopButton": [
          "button[data-testid='stop-button']",
          "button[aria-label*='Stop' i]",
          "button[aria-label*='중지' i]"
        ],
        "assistantMessage": [
          "[data-message-author-role='assistant']",
          "div.agent-turn",
          "div[data-testid*='conversation-turn'] .markdown"
        ],
        "preCode": [
          "pre code",
          "div.code-block pre"
        ],
        "errorBanner": [
          ".text-red-500",
          "[data-testid*='error-notification']",
          "div.border-red-500"
        ],
        "loginIndicator": [
          "button[data-testid='login-button']",
          "a[href*='/auth/login']",
          "button:contains('Log in')"
        ],
        "challengeIndicator": [
          "#cf-challenge-running",
          "iframe[src*='challenges.cloudflare.com']",
          "#challenge-form"
        ]
      },
      "quirks": {
        "lateDomReplacement": true,
        "notes": "ChatGPT frequently replaces the prompt-textarea DOM node during initial hydration. If fill verification fails, reset fill state and re-locate node."
      }
    },
    "claude": {
      "id": "claude",
      "displayName": "Anthropic Claude",
      "status": "active",
      "initialUrl": "https://claude.ai/new",
      "allowedScriptOrigins": [
        "https://claude.ai"
      ],
      "allowedAuthOrigins": [
        "https://accounts.google.com",
        "https://claude.ai/login",
        "https://claude.ai/api/auth"
      ],
      "selectors": {
        "promptInput": [
          "div.ProseMirror[contenteditable='true']",
          "div[contenteditable='true'][role='textbox']",
          "fieldset div[contenteditable='true']"
        ],
        "submitButton": [
          "button[aria-label*='Send' i]",
          "button[aria-label*='전송' i]",
          "button:has(svg[data-icon='paper-plane'])",
          "fieldset button[type='button']:not([disabled])"
        ],
        "stopButton": [
          "button[aria-label*='Stop' i]",
          "button[aria-label*='중단' i]",
          "button[aria-label*='Stop generating' i]"
        ],
        "assistantMessage": [
          "div[data-is-streaming]",
          "div.font-claude-message",
          "div[data-testid='assistant-message']",
          ".standard-grid .font-user-message + div"
        ],
        "preCode": [
          "pre code",
          "div.code-block code"
        ],
        "errorBanner": [
          "div[data-testid*='error']",
          ".bg-danger-100",
          "div.text-danger"
        ],
        "loginIndicator": [
          "input[type='email'][name='email']",
          "a[href*='/login']",
          "button[data-testid*='login']"
        ],
        "challengeIndicator": [
          "iframe[src*='cloudflare']",
          "div#challenge-stage",
          "iframe[src*='turnstile']"
        ]
      },
      "quirks": {
        "proseMirrorEditor": true,
        "notes": "Claude uses ProseMirror contenteditable editor. Requires synthetic input event with InputEvent constructor and paragraph wrappers."
      }
    },
    "grok": {
      "id": "grok",
      "displayName": "xAI Grok",
      "status": "dormant_excluded",
      "exclusionRationale": "Excluded from active user roster because internal thinking/working duration and response UI text leaked into extracted results on mobile web.",
      "initialUrl": "https://grok.com/",
      "allowedScriptOrigins": [
        "https://grok.com",
        "https://x.ai"
      ],
      "allowedAuthOrigins": [
        "https://x.com",
        "https://twitter.com",
        "https://auth.x.ai"
      ],
      "selectors": {
        "promptInput": [
          "textarea[placeholder*='Ask' i]",
          "textarea.w-full",
          "div[role='textbox']"
        ],
        "submitButton": [
          "button[aria-label*='Submit' i]",
          "button[aria-label*='Send' i]",
          "button:has(svg.lucide-arrow-up)"
        ],
        "stopButton": [
          "button[aria-label*='Stop' i]"
        ],
        "assistantMessage": [
          "div.response-body",
          "div[data-testid='grok-response']",
          ".message-bubble-assistant"
        ],
        "preCode": [
          "pre code"
        ],
        "errorBanner": [
          ".text-destructive",
          "div.error-container"
        ],
        "loginIndicator": [
          "a[href*='/login']",
          "button:contains('Sign in')"
        ],
        "challengeIndicator": [
          "iframe[src*='challenges']"
        ]
      },
      "quirks": {
        "workDurationHeaderRegex": "^(Thought for \\d+ seconds?|Thinking Process:?|Thinking:?)\\s*\\n*",
        "notes": "Kept as reference schema only. Do not display in default user provider list."
      }
    }
  }
}
